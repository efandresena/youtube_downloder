{
  "manifest_version": 3,
  "name": "YDM - YouTube Download Manager",
  "version": "1.0.0",
  "description": "One-click YouTube downloads via YDM. Detects videos, fetches formats, and sends to the YDM desktop app.",
  "author": "YDM Project",

  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "notifications",
    "nativeMessaging"
  ],

  "host_permissions": [
    "*://www.youtube.com/*",
    "*://youtube.com/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "YDM - YouTube Download Manager",
    "default_popup": "popup/popup.html"
  }
}
